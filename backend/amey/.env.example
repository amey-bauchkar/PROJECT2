# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI (Leave empty to use automatic in-memory fallback)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smartschedule?retryWrites=true&w=majority

# Groq Vision/Chat AI API Key (Optional: system uses local rule engine if offline/empty)
GROQ_API_KEY=gsk_your_groq_api_key_here
